PROJECT_NAME           = "EpiGimp"
PROJECT_NUMBER         = "1.0.0"
PROJECT_BRIEF          = "Raster graphics editor built with Electron, React, TypeScript and HTML5 Canvas"

OUTPUT_DIRECTORY       = docs/doxygen

CREATE_SUBDIRS         = NO

OUTPUT_LANGUAGE        = English

BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES

INPUT                   = README.md \
                          src \
                          electron

USE_MDFILE_AS_MAINPAGE  = README.md

RECURSIVE               = YES

FILE_PATTERNS           = *.ts \
                          *.tsx

EXCLUDE_PATTERNS        = */node_modules/* \
                          */dist/* \
                          */dist-electron/*

SOURCE_BROWSER          = YES
INLINE_SOURCES          = NO

STRIP_CODE_COMMENTS     = NO

GENERATE_HTML           = YES
HTML_OUTPUT             = html

GENERATE_LATEX          = NO

GENERATE_XML            = NO

QUIET                   = NO
WARNINGS                = YES

WARN_IF_UNDOCUMENTED    = NO
WARN_IF_DOC_ERROR       = YES

JAVADOC_AUTOBRIEF       = YES

MARKDOWN_SUPPORT        = YES

GENERATE_TREEVIEW       = YES

DISABLE_INDEX           = NO

HAVE_DOT                = NO
